# Copy to /srv/minna/.env on the server and fill in. Never commit the filled copy.
#
# This is the API's environment. The two Vue apps have none at run time —
# whatever they need is baked into their bundles at build time, which is why
# the only build arguments are the two public ones (see build-push.ps1).
#
# NODE_ENV, PORT and HOST are set by docker-compose.prod.yml, not here.

# Both apps' hostnames, comma separated, no trailing slash. Requests arrive
# same-origin through nginx so CORS is rarely exercised, but the Flutter app
# and anything calling from elsewhere go through it.
CORS_ORIGINS=https://minna.learnsbuy.com,https://minna-admin.learnsbuy.com

# A database of its own. Never the one holding the old Laravel tables: ten
# table names collide and the first migration would fail on them.
DATABASE_URL=mysql://doadmin:PASSWORD@db-mysql-xxxxx.ondigitalocean.com:25060/minna
DATABASE_SSL=true
# Path inside the container. docker-compose.prod.yml mounts ./certs there, so
# put the provider's CA at /srv/minna/certs/ca-certificate.crt.
#
# DATABASE_SSL on its own still connects, but without verifying the server —
# the API says so at boot. Set this and the warning goes away because the
# connection is actually checked.
DATABASE_SSL_CA=./certs/ca-certificate.crt

# Optional. Left empty the API runs without it.
REDIS_URL=

# Generate each with: openssl rand -base64 48
# Changing either one signs everybody out, which is the point of having them
# separate: the access secret can be rotated without ending every session.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# space-kim — file storage with expiring signed URLs.
# The key is scoped to SPACE_FOLDER and the service refuses any path outside it.
SPACE_BASE_URL=https://space.learnsbuy.com
SPACE_API_KEY=
SPACE_FOLDER=minna
SIGNED_URL_TTL=21600

# Live keys. The webhook secret is the one Stripe shows when the endpoint is
# created — point that endpoint at:
#   https://minna.learnsbuy.com/api/v1/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where buyers are sent back to, and where mailed links point. No trailing slash.
APP_URL=https://minna.learnsbuy.com
# Mailed to a teacher when their application is approved.
ADMIN_URL=https://minna-admin.learnsbuy.com

# Mail.
#
# Two ways out, and the one that works everywhere is tried first.
#
# RESEND_API_KEY sends over HTTPS. Use this on any DigitalOcean droplet:
# they block outbound SMTP, so every SMTP connection times out there and
# nothing is delivered — silently, because mail is sent and not awaited.
RESEND_API_KEY=

# Mail must come from a domain this school owns, or it fails the checks
# every inbox now makes. A free-provider address cannot be used here and
# Resend refuses one outright.
MAIL_FROM=Minna No Nihongo <no-reply@learnsbuy.com>
# Where a reply goes instead. For somebody who reads their mail at Gmail.
MAIL_REPLY_TO=learnsbuy@gmail.com

# SMTP, for a machine that can reach a mail server and would rather use one.
# Ignored when RESEND_API_KEY is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# reCAPTCHA v3, server half. The matching site key is a build argument, not an
# entry here — it ships inside the bundle because the browser needs it.
RECAPTCHA_SECRET=
