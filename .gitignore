# ---- common ----
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-error.log*
.idea/
.vscode/
.fleet/
.nova/
.zed/

# ---- node (frontend / backend / api) ----
node_modules/
dist/
.vite/
*.tsbuildinfo
.env
.env.*
!.env.example
!.env.prod.example

# ---- api ----
/api/drizzle/meta/_journal.json.bak
/api/uploads/

# The managed database's CA certificate. Not a secret — it is the public half
# used to check that the server is who it says — but it belongs to whichever
# database this checkout is pointed at, not to the code. On the server it is
# mounted from /srv/minna/certs instead.
/api/certs/
/certs/

# ---- legacy laravel ----
/_legacy/vendor/
/_legacy/node_modules/
/_legacy/public/build/
/_legacy/public/hot/
/_legacy/public/storage
/_legacy/storage/*.key
/_legacy/storage/pail/
/_legacy/storage/framework/cache/
/_legacy/storage/framework/sessions/
/_legacy/storage/framework/views/
/_legacy/storage/logs/
/_legacy/.phpunit.cache
/_legacy/.phpunit.result.cache
/_legacy/.phpactor.json
/_legacy/auth.json

# ---- design reference ----
# _design-ref is its own git repo (READ VPN prototype).
# Clone it from https://github.com/ideavivat/Frontend-Readvpn.git if you need it.
/_design-ref/

# ---- stray empty dir left by the restructure (safe to delete by hand) ----
/Frontend-Read/

# Fixture photography copied from _design-ref by
# frontend/scripts/copy-fixture-images.mjs. Not ours to commit, and temporary.
/frontend/public/assets/img/

# Rendered DOM of the reference pages, produced by frontend/scripts/dump-reference.mjs.
# Regenerate with: npm run ref:dump
/frontend/.reference-dom/

# Scratch pages used to seed the prototype session for screenshots. Dev only.
/frontend/public/__seed*.html

# Screenshots the browser flow tests leave behind. `SHOT_DIR` defaults to the
# package it is run from, so a run drops a dozen PNGs next to package.json —
# evidence from one run on one machine, nine megabytes of it, and stale the
# moment anything changes. Point SHOT_DIR somewhere else to keep them.
/frontend/*.png
/backend/*.png
