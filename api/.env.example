# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Where the two Vue apps run in development. Comma separated, no trailing slash.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Matches docker-compose.dev.yml (3308: 3306 and 3307 are taken on this machine).
DATABASE_URL=mysql://minna:minna@127.0.0.1:3308/minna

REDIS_URL=redis://127.0.0.1:6380

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# DigitalOcean Spaces (S3 compatible)
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_REGION=sgp1
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
# How long a lesson video URL stays valid, in seconds.
SIGNED_URL_TTL=300

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where Stripe sends the buyer back to. No trailing slash.
APP_URL=http://localhost:5173
