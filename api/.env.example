# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Where the two Vue apps run in development. Comma separated, no trailing slash.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Local container, from docker-compose.dev.yml (3308: 3306 and 3307 are taken
# on this machine).
DATABASE_URL=mysql://minna:minna@127.0.0.1:3308/minna

# DigitalOcean managed MySQL looks like this instead. Point it at a database of
# its own, never at one holding the old Laravel tables: ten table names collide
# and the migration would fail on the first of them.
#   DATABASE_URL=mysql://doadmin:PASSWORD@db-mysql-....ondigitalocean.com:25060/minna_v2
#   DATABASE_SSL=true
#   DATABASE_SSL_CA=./certs/ca-certificate.crt
DATABASE_SSL=false
DATABASE_SSL_CA=

REDIS_URL=redis://127.0.0.1:6380

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# space-kim — self-hosted file storage (D:/Nodejs/space-kim).
# The API key is scoped to its own folder, so this project cannot reach
# another one's files. Store the path it returns, never the URL: a URL
# expires, a path does not, and signing again costs nothing.
#   production  SPACE_BASE_URL=https://space.learnsbuy.com
#   local       SPACE_BASE_URL=http://localhost:3900  (run space-kim from D:/Nodejs/space-kim)
SPACE_BASE_URL=https://space.learnsbuy.com
SPACE_API_KEY=
# The folder the key is scoped to. The service rejects any path outside it.
SPACE_FOLDER=minna
# How long a signed URL lasts, in seconds. 21600 = 6 hours, long enough for
# a lesson video and a pause in the middle of it. The service caps it at 7 days.
SIGNED_URL_TTL=21600

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The public site, used for links in mail and for Stripe to send the buyer
# back to. The frontend, not the admin app. No trailing slash.
APP_URL=http://localhost:5174

# The admin, where teachers and staff sign in. Mailed to a teacher when their
# application is approved.
ADMIN_URL=http://localhost:5173

# Mail.
#
# Two ways out, and the one that works everywhere is tried first.
#
# RESEND_API_KEY sends over HTTPS. Use this on any DigitalOcean droplet:
# they block outbound SMTP, so every SMTP connection times out there and
# nothing is delivered — silently, because mail is sent and not awaited.
RESEND_API_KEY=

# Mail must come from a domain this school owns, or it fails the checks
# every inbox now makes. A free-provider address cannot be used here and
# Resend refuses one outright.
MAIL_FROM=Minna No Nihongo <no-reply@learnotive.com>
# Where a reply goes instead. For somebody who reads their mail at Gmail.
MAIL_REPLY_TO=learnsbuy@gmail.com

# SMTP, for a machine that can reach a mail server and would rather use one.
# Ignored when RESEND_API_KEY is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
