/**
 * Bank details and an ID document for the demo teachers, so the screens can be
 * looked at with something in them.
 *
 *   npx tsx scripts/seed-payout-demo.mts            # fill them in
 *   npx tsx scripts/seed-payout-demo.mts --clear    # take them out again
 *
 * Only the seeded demo teachers — the `@minna.local` accounts the sample data
 * creates. Every other teacher is skipped, by name, and that is the whole
 * point of this file rather than a few UPDATE statements typed at a prompt.
 *
 * This database is the live one. A plausible-looking account number sitting on
 * a real teacher's record is how money reaches the wrong bank: somebody opens
 * the payout screen, reads what is there, and transfers. So the numbers below
 * are deliberately impossible — a Thai account is ten digits and these are all
 * zeroes bar one — and the account names say DEMO where a person's name goes.
 *
 * The identity document is a generated picture that says what it is. No real
 * document is involved, and none should ever be put here.
 */
import { eq, inArray, like, sql } from 'drizzle-orm'
import { db } from '../src/db/client'
import { teacherPayoutDetails, users } from '../src/db/schema/index'
import { storageRoot, uploadFile } from '../src/lib/storage'

const clearing = process.argv.includes('--clear')

/** The sample data's own teachers, and nobody else. */
const rows = await db
  .select({ id: users.id, firstName: users.firstName, lastName: users.lastName, email: users.email })
  .from(users)
  .innerJoin(sql`user_roles ur`, sql`ur.user_id = ${users.id}`)
  .innerJoin(sql`roles r`, sql`r.id = ur.role_id`)
  .where(sql`r.name = 'teacher' AND ${users.email} LIKE '%@minna.local'`)

if (!rows.length) {
  console.log('No demo teachers found. Nothing to do.')
  process.exit(0)
}

if (clearing) {
  await db.delete(teacherPayoutDetails).where(
    inArray(teacherPayoutDetails.userId, rows.map((r) => r.id)),
  )
  console.log(`Cleared payout details for ${rows.length} demo teacher(s).`)
  process.exit(0)
}

/**
 * One bank each, so the screen shows variety rather than the same row five
 * times — and one of them abroad, because that is the case the country and
 * SWIFT fields exist for and the one nobody tests.
 */
const BANKS = [
  { country: 'TH', bank: 'Kasikornbank', swift: 'KASITHBK', branch: 'สยามสแควร์', currency: 'THB' },
  { country: 'TH', bank: 'Bangkok Bank', swift: 'BKKBTHBK', branch: 'อโศก', currency: 'THB' },
  { country: 'TH', bank: 'Siam Commercial Bank', swift: 'SICOTHBK', branch: 'รัชดาภิเษก', currency: 'THB' },
  { country: 'JP', bank: 'MUFG Bank', swift: 'BOTKJPJT', branch: 'Shinjuku', currency: 'JPY' },
  { country: 'TH', bank: 'Krungthai Bank', swift: 'KRTHTHBK', branch: 'ลาดพร้าว', currency: 'THB' },
  { country: 'VN', bank: 'Vietcombank', swift: 'BFTVVNVX', branch: 'Hanoi', currency: 'VND' },
]

/**
 * A picture that says what it is, in case it is ever seen out of context.
 *
 * An SVG rather than a photograph: it cannot be mistaken for somebody's actual
 * passport at a glance, which a stock photo of a card could be.
 */
function demoDocument(name: string): Buffer {
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="1000" height="640" viewBox="0 0 1000 640">
  <rect width="1000" height="640" fill="#eef2f7"/>
  <rect x="40" y="40" width="920" height="560" rx="24" fill="#ffffff" stroke="#c7d2de" stroke-width="3"/>
  <text x="80" y="150" font-family="Arial, sans-serif" font-size="56" font-weight="bold" fill="#1f2a37">DEMO DOCUMENT</text>
  <text x="80" y="215" font-family="Arial, sans-serif" font-size="30" fill="#5b6b7f">Not a real ID card or passport.</text>
  <text x="80" y="265" font-family="Arial, sans-serif" font-size="30" fill="#5b6b7f">Sample data for ${name}.</text>
  <rect x="80" y="320" width="260" height="200" rx="12" fill="#dbe3ec"/>
  <text x="120" y="430" font-family="Arial, sans-serif" font-size="26" fill="#8795a7">photo</text>
  <text x="380" y="370" font-family="Arial, sans-serif" font-size="26" fill="#8795a7">Name</text>
  <text x="380" y="410" font-family="Arial, sans-serif" font-size="32" fill="#1f2a37">${name}</text>
  <text x="380" y="470" font-family="Arial, sans-serif" font-size="26" fill="#8795a7">Number</text>
  <text x="380" y="510" font-family="Arial, sans-serif" font-size="32" fill="#1f2a37">0-0000-00000-00-0</text>
  <text x="80" y="570" font-family="Arial, sans-serif" font-size="22" fill="#9aa7b8">Generated by seed-payout-demo.mts</text>
</svg>`
  return Buffer.from(svg, 'utf8')
}

let done = 0
for (const [i, t] of rows.entries()) {
  const b = BANKS[i % BANKS.length]!
  const name = `${t.firstName} ${t.lastName}`.trim()

  // Outside `content/`, like every real one: the same folder the teacher's own
  // upload would land in, so the screens read it exactly as they would theirs.
  const folder = `${storageRoot()}/identity/${t.id}`
  let stored: string | null = null
  try {
    const file = await uploadFile({
      folder,
      filename: 'demo-document.svg',
      body: demoDocument(name),
      contentType: 'image/svg+xml',
      keepName: true,
    })
    stored = file.path
  } catch (err) {
    // Storage may not be configured on a machine that only runs the API. The
    // bank details are still worth filling in, so this is a note, not a stop.
    console.log(`  (no document for ${name}: ${(err as Error).message.slice(0, 60)})`)
  }

  const values = {
    bankCountry: b.country,
    bankName: b.bank,
    accountName: `DEMO ${name.toUpperCase()}`,
    // Impossible on purpose. A real Thai account is ten digits; this is not an
    // account anywhere, so nobody can transfer to it by mistake.
    accountNumber: `000-0-00000-${i}`,
    branch: b.branch,
    swift: b.swift,
    payoutCurrency: b.currency,
    ...(stored
      ? { idDocumentPath: stored, idDocumentUploadedAt: new Date(), idDocumentBy: t.id }
      : {}),
  }

  const [exists] = await db
    .select({ userId: teacherPayoutDetails.userId })
    .from(teacherPayoutDetails)
    .where(eq(teacherPayoutDetails.userId, t.id))
    .limit(1)

  if (exists) {
    await db.update(teacherPayoutDetails).set(values).where(eq(teacherPayoutDetails.userId, t.id))
  } else {
    await db.insert(teacherPayoutDetails).values({ userId: t.id, ...values })
  }
  console.log(`  ${name} — ${b.bank} (${b.country}) ${values.accountNumber} ${b.currency}`)
  done += 1
}

console.log(`\nFilled in ${done} demo teacher(s). Undo with --clear.`)
process.exit(0)
