{
  "name": "minna-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "check:storage": "tsx scripts/check-storage.ts",
    "seed:teachers": "tsx scripts/seed-teachers.ts",
    "seed:hero": "tsx scripts/seed-hero.mts",
    "seed:catalog": "tsx scripts/seed-catalog.mts",
    "clean:test-users": "tsx scripts/clean-test-users.mts",
    "seed:coupons": "tsx scripts/seed-coupons.mts",
    "seed:free-courses": "tsx scripts/seed-free-courses.mts",
    "seed:lesson-media": "tsx scripts/seed-lesson-media.mts",
    "seed:quiz": "tsx scripts/seed-quiz.mts",
    "seed:kanji-quiz": "tsx scripts/seed-kanji-quiz.mts",
    "seed:german": "tsx scripts/seed-german.mts",
    "smoke:my-orders": "tsx scripts/smoke-my-orders.mts",
    "smoke:account-settings": "tsx scripts/smoke-account-settings.mts",
    "smoke:sessions": "tsx scripts/smoke-sessions.mts",
    "smoke:teacher-onboarding": "tsx scripts/smoke-teacher-onboarding.mts",
    "smoke:teacher-boundary": "tsx scripts/smoke-teacher-boundary.mts",
    "smoke:teacher-numbers": "tsx scripts/smoke-teacher-numbers.mts",
    "smoke:earnings": "tsx scripts/smoke-earnings.mts",
    "smoke:notifications": "tsx scripts/smoke-notifications.mts",
    "add:notifications-table": "tsx scripts/add-notifications-table.mts",
    "add:earnings-table": "tsx scripts/add-earnings-table.mts",
    "mature:earnings": "tsx scripts/mature-earnings.mts",
    "add:consents-table": "tsx scripts/add-consents-table.mts",
    "smoke:catalog-scope": "tsx scripts/smoke-catalog-scope.mts",
    "smoke:coupon-scope": "tsx scripts/smoke-coupon-scope.mts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.8.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^4.0.2",
    "mysql2": "^3.11.5",
    "nodemailer": "^10.0.15",
    "sanitize-html": "^2.17.5",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.30.1",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
  }
}
